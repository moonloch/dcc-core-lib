{
  "name": "@moonloch/dcc-core-lib",
  "version": "0.15.1",
  "description": "Pure-function TypeScript game-logic library for the Dungeon Crawl Classics RPG (dice chain, checks, combat, spells, character creation). No platform dependencies and no official rulebook data.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonloch/dcc-core-lib.git"
  },
  "homepage": "https://github.com/moonloch/dcc-core-lib#readme",
  "bugs": {
    "url": "https://github.com/moonloch/dcc-core-lib/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm run build:dts",
    "build:dts": "dts-bundle-generator --no-check --export-referenced-types --out-file dist/dcc-core-lib.d.ts src/index.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "clean": "rm -rf dist",
    "docs:api": "typedoc",
    "docs:check": "pnpm run docs:api && git diff --exit-code --stat docs/api",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "dcc",
    "dungeon-crawl-classics",
    "rpg",
    "ttrpg",
    "dice",
    "game-logic",
    "foundry-vtt"
  ],
  "author": "Tim L. White",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "dts-bundle-generator": "9.5.1",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.4.2"
}
